{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "STORE_KEY": "readonly",
    "THEME_KEY": "readonly",
    "BACKUP_PREFIX": "readonly",
    "DB_SCHEMA_VERSION": "readonly",
    "MAX_IMPORT_BYTES": "readonly",
    "lastRIR": "writable",
    "wakeLock": "readonly",
    "utils": "readonly",
    "validate": "readonly",
    "backup": "readonly",
    "mergeEngine": "readonly",
    "analytics": "readonly",
    "db": "writable",
    "state": "writable",
    "logic": "readonly",
    "ui": "readonly",
    "actions": "readonly",
    "Capacitor": "readonly",
    "console": "readonly",
    "localStorage": "readonly",
    "navigator": "readonly",
    "document": "readonly",
    "window": "readonly",
    "URL": "readonly",
    "Blob": "readonly",
    "setTimeout": "readonly",
    "confirm": "readonly",
    "prompt": "readonly",
    "alert": "readonly",
    "parseFloat": "readonly",
    "parseInt": "readonly",
    "isNaN": "readonly",
    "Date": "readonly",
    "Math": "readonly",
    "JSON": "readonly",
    "Array": "readonly",
    "Object": "readonly",
    "Set": "readonly",
    "Map": "readonly",
    "String": "readonly",
    "Boolean": "readonly",
    "Error": "readonly",
    "encodeURIComponent": "readonly",
    "decodeURIComponent": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-implicit-coercion": "warn",
    "eqeqeq": ["error", "always"],
    "no-else-return": "warn",
    "no-eq-null": "error",
    "no-console": "off",
    "no-alert": "off",
    "no-undef": "off",
    "no-redeclare": "off"
  }
}
